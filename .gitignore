# Local-only lockfile from running `uv` directly -- the project installs via
# `pip install -e .` everywhere (CI, README, launchd agent) and has no [tool.uv]
# config, so this isn't a source of truth anything reads.
uv.lock

# Built .app bundle -- rebuild with macos/build.sh
macos/TeetimeMonitor.app/
# SPM build output for the macOS GUI's own test suite (swift run TeetimeMonitorCoreTests)
macos/.build/
# Actual/diff PNGs a failed `swift run VisualRegressionRunner` writes for inspection --
# References/*.png (the golden images) are the only PNGs under Tests/ that ARE tracked.
macos/Tests/VisualRegressionRunner/Failures/*.png
