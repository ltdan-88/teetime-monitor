# For a single club, these two are enough:
PCC_USER=
PCC_PASS=

# For more than one club (see clubs/ and ROADMAP.md Phase 0), add namespaced overrides
# instead — one pair per club id (the filename in clubs/, without ".yaml"):
# PCC_USER__home-club=
# PCC_PASS__home-club=
# PCC_USER__guest-club=
# PCC_PASS__guest-club=

# Powers ai_assist.py (ROADMAP.md "AI placement" note) -- tee-sheet parsing,
# recommendation ranking, and history summarization. One key covers every saved club.
ANTHROPIC_API_KEY=
