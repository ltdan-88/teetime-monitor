# One pc caddie login covers every club under the same account (confirmed 2026-09-05 —
# not a single-club shortcut, the normal case). These two are usually all you need,
# even with several clubs saved under clubs/. Easier than hand-editing this file:
# `python -m src.credentials_screen` sets them from the UI (creates a real .env from
# this template if you don't have one yet).
PCC_USER=
PCC_PASS=

# Only needed for the genuine edge case — a specific club that actually requires
# separate credentials. Namespaced per club id (the filename in clubs/, without
# ".yaml"), and only overrides the plain pair above for that one club:
# PCC_USER__guest-club=
# PCC_PASS__guest-club=

# Powers ai_assist.py (ROADMAP.md "AI placement" note) -- tee-sheet parsing,
# recommendation ranking, and history summarization. One key covers every saved club.
ANTHROPIC_API_KEY=
